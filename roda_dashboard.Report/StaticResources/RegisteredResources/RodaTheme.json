{
  "name": "Roda JC",
  "dataColors": [
    "#F5C400",
    "#8A8F98",
    "#E5484D",
    "#4FA3F7",
    "#30A46C",
    "#C084FC",
    "#F97316",
    "#14B8A6"
  ],
  "background": "#161A21",
  "foreground": "#E6E8EB",
  "tableAccent": "#F5C400",
  "good": "#30A46C",
  "bad": "#E5484D",
  "neutral": "#8A8F98",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#F5C400"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6E8EB"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6E8EB"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A0A6B0"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0E1116"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0E1116"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#161A21"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#262B34"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 16,
            "right": 16
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6E8EB"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#262B34"
              }
            },
            "rowPadding": 7,
            "textSize": 15
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A0A6B0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#161A21"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6E8EB"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#161A21"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6E8EB"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#1B2028"
              }
            }
          }
        ]
      }
    }
  }
}