model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: nl-NL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["wedstrijden","ThuisPerspectief","UitPerspectief","TeamWedstrijden","Teams","_Metingen"]

annotation PBI_ProTooling = ["DevMode"]

ref table TeamWedstrijden
ref table Teams
ref table Datum
ref table _Metingen

ref cultureInfo en-US

